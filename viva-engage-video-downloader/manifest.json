{
  "manifest_version": 3,
  "name": "Viva Engage Video Downloader",
  "version": "1.0.0",
  "description": "Detecta y descarga los videos que reproduces en Viva Engage (Yammer).",
  "permissions": [
    "webRequest",
    "downloads",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Viva Engage Video Downloader",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "mse-capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}